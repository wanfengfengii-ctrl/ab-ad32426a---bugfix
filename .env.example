# Host port that exposes the web UI and API.
HOST_PORT=8080

# Container-internal port the FastAPI process binds (health check uses it).
APP_PORT=8000

# Container health-check tuning.
HEALTH_INTERVAL=15s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=5
HEALTH_START_PERIOD=10s
HEALTH_PATH=/api/health

# Dev-only: Vite proxy target for the API.
VITE_API_TARGET=http://localhost:8000
